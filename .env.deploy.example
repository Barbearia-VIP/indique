# Copie para .env.deploy (não vai para o git) e preencha.

# Servidor (acesso por chave SSH)
DEPLOY_HOST=                         # IP ou hostname do servidor
DEPLOY_USER=deploy                   # usuário SSH; precisa de sudo só no "setup"
DEPLOY_PORT=22
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519   # opcional: chave específica

# Site
DEPLOY_DOMAIN=indique.barbearia.vip
DEPLOY_PATH=/var/www/indique.barbearia.vip
DEPLOY_KEEP_RELEASES=5               # versões guardadas para rollback

# E-mail para avisos do Let's Encrypt (obrigatório no primeiro "setup")
CERTBOT_EMAIL=

# Opcional: verificar o site antes do DNS apontar para o servidor
# DEPLOY_CURL_OPTS="--resolve indique.barbearia.vip:443:IP_DO_SERVIDOR"
